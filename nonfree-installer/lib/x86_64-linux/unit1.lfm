  object Label1: TLabel
    Left = 8
    Height = 221
    Top = 8
    Width = 474
    Caption = 'The kernel-firmware-nonfree package is not included in MgaRemix-Proserpina.'#10'The approximate size after installation is 1.5 GB.'#10'  '#10'This package contains all the firmware files without an open source'#10'license but used by the in-kernel drivers.'#10'  '#10'The files are shared by all kernels.'#10'  '#10'Other non-free firmware files are contained in the radeon-firmware,'#10'iwlwifi-firmware, ralink-firmware and rtlwifi-firmware packages.'#10'  '#10'Open source firmware files are contained in the kernel-firmware'#10'package in the core section.'
  end
